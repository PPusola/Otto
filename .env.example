# Core server
JARVIS_APP_NAME=JARVIS
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_AUTH_TOKEN=change-me-generate-a-long-random-token
JARVIS_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

# Ollama
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=mistral:7b

# Local storage
JARVIS_DATA_DIR=.jarvis-data
JARVIS_MEMORY_PASSWORD=change-me-memory-password

# Voice
JARVIS_WHISPER_CPP_BINARY=
JARVIS_WHISPER_CPP_MODEL=

# Spotify OAuth
JARVIS_SPOTIFY_CLIENT_ID=
JARVIS_SPOTIFY_CLIENT_SECRET=
JARVIS_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/api/spotify/callback
JARVIS_SPOTIFY_DEFAULT_DEVICE_ID=

# Tool policy
JARVIS_ALLOW_SPOTIFY_AUTORUN=true
JARVIS_ALLOW_WIZ_AUTORUN=true
JARVIS_WIZ_LIGHTS=desk=192.168.1.50,bedroom=192.168.1.51
JARVIS_WIZ_BROADCAST=192.168.1.255
